{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Melayu Deli Daily Expression Schema",
  "type": "object",
  "required": [
    "id",
    "expression",
    "normalized_expression",
    "meaning_id",
    "category",
    "dialect",
    "region",
    "usage_context",
    "variants",
    "example_dialogue",
    "example_translation",
    "source_ids",
    "confidence",
    "verification_status",
    "notes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^EXP-\\d{6}$"
    },
    "expression": {
      "type": "string"
    },
    "normalized_expression": {
      "type": "string"
    },
    "meaning_id": {
      "type": "string"
    },
    "literal_meaning_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "category": {
      "type": "string"
    },
    "dialect": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "usage_context": {
      "type": "string"
    },
    "pronunciation": {
      "type": [
        "string",
        "null"
      ]
    },
    "jawi_script": {
      "type": [
        "string",
        "null"
      ]
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "example_dialogue": {
      "type": [
        "string",
        "null"
      ]
    },
    "example_translation": {
      "type": [
        "string",
        "null"
      ]
    },
    "cultural_note": {
      "type": [
        "string",
        "null"
      ]
    },
    "katara_legacy_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^SRC-\\d{4}$"
      }
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "verified",
        "needs_review",
        "disputed",
        "rejected"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
