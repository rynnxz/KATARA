{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Melayu Deli Vocabulary Entry Schema",
  "type": "object",
  "required": [
    "id",
    "term",
    "normalized_term",
    "meaning_id",
    "part_of_speech",
    "category",
    "dialect",
    "region",
    "usage_context",
    "pronunciation",
    "variants",
    "example_sentence",
    "example_translation",
    "source_ids",
    "confidence",
    "verification_status",
    "notes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^MD-\\d{6}$"
    },
    "term": {
      "type": "string"
    },
    "normalized_term": {
      "type": "string"
    },
    "meaning_id": {
      "type": "string"
    },
    "part_of_speech": {
      "type": "string",
      "enum": [
        "noun",
        "verb",
        "adjective",
        "adverb",
        "pronoun",
        "numeral",
        "preposition",
        "conjunction",
        "interjection",
        "particle"
      ]
    },
    "category": {
      "type": "string"
    },
    "dialect": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "usage_context": {
      "type": "string",
      "enum": [
        "formal",
        "informal",
        "neutral",
        "cultural",
        "archaic"
      ]
    },
    "pronunciation": {
      "type": [
        "string",
        "null"
      ]
    },
    "jawi_script": {
      "type": [
        "string",
        "null"
      ]
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "example_sentence": {
      "type": [
        "string",
        "null"
      ]
    },
    "example_translation": {
      "type": [
        "string",
        "null"
      ]
    },
    "katara_legacy_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^SRC-\\d{4}$"
      }
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "verified",
        "needs_review",
        "disputed",
        "rejected"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
